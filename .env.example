# Option A: Google AI Studio API Key (Quickest local setup)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Option B: Google Cloud Vertex AI / Agent Engine (Production setup)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model & Telemetry Configuration
WAR_ROOM_MODEL=gemini-2.5-flash
WAR_ROOM_CRITIC_MODEL=gemini-2.5-flash
WAR_ROOM_ENABLE_CLOUD_TRACE=FALSE
WAR_ROOM_OFFLINE_FALLBACK=FALSE
